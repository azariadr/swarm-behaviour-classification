      "source": [
        "variance=[]\n",
        "p=[50,100,150,200,300,400,500,600,700,800,900,1000,1100,1300,1500,1700,1900,2000]\n",
        "for p in p:\n",
        "    pca_model=PCA(n_components=p)\n",
        "    pca_model.fit(X)\n",
        "    variance.append(np.sum(pca_model.explained_variance_ratio_))\n",
        "    print(\"Components:\",p)"
      ]
    },
